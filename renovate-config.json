{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Digital Conveniences organization default Renovate preset",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "America/Port_of_Spain",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 10,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "GitHub Actions non-major updates"
    },
    {
      "description": "Group non-major NuGet updates",
      "matchManagers": [
        "nuget"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "NuGet non-major updates"
    },
    {
      "description": "Group non-major npm updates",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm non-major updates"
    }
  ]
}
